{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "rules": {
    // Next.js compiles JSX with the automatic runtime, so `React` does not
    // need to be in scope. Same reason eslint-config-next turns this off.
    "react/react-in-jsx-scope": "off",

    // `next/image` requires a loader that `output: "export"` does not provide,
    // so Avatar.tsx emits a raw <img>.
    "nextjs/no-img-element": "off",

    // The rule guards against a font that loads on only one page. head/Meta.tsx
    // is rendered from the page rather than from _document, but the site is a
    // single page, so the font is already loaded everywhere it is needed.
    "nextjs/no-page-custom-font": "off"
  },
  // next-env.d.ts は Next.js が生成し、ファイル自身が編集を禁じている。
  // Next 16 から副作用 import を含むようになり import/no-unassigned-import に
  // 触れるが、こちらでは直せないので対象外にする。
  "ignorePatterns": [".next", "out", "node_modules", "next-env.d.ts"]
}
